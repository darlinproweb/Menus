# Copia este archivo a .env.local y llena los valores
# Los encuentras en Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# URL base de producción (sin barra final) — usada para Open Graph y QR
# En desarrollo puedes dejarlo vacío (usa localhost automáticamente)
NEXT_PUBLIC_APP_URL=https://tudominio.com
